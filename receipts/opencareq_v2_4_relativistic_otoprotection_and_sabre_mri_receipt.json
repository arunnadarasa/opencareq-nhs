  "paperclip_v2_4_evidence_pins": {
    "pmc13712653_nice_ta1001_siopel6_sts_cisplatin": "L1-L9:Anhydrous sodium thiosulfate (Pedmarqsi, NICE TA1001; SIOPEL 6 NEJM) infused 6 hours after cisplatin chemotherapy reduces permanent childhood sensorineural hearing loss by ~48% (33% vs 63%, RR 0.52) in localized solid tumours, whereas simultaneous administration or use in disseminated disease risks platinum inactivation.",
    "pmc8938898_l2_l11_nice_hte6_paloh_mtrnr1": "L2-L11:Manchester NHS PALOH pragmatic trial (JAMA Pediatrics 2022, NICE HTE6 Genedrive MT-RNR1 ID Kit) achieved 26-minute bedside neonatal intensive care m.1555A>G genotyping within the 60-minute sepsis Golden Hour, switching carriers from gentamicin to cefotaxime with zero antibiotic delay and preventing lifelong aminoglycoside deafness.",
    "pmc6764278_pmc9310590_sabre_parahydrogen_lac": "L1-L8:Signal Amplification by Reversible Exchange (SABRE / SABRE-SHEATH) transfers nuclear-spin singlet order from rotational-J=0 para-hydrogen across a microtesla/millitesla Level Anti-Crossing on an iridium(I)-NHC catalyst into [1-13C]pyruvate (>10^4-10^5x polarization boost in <60s without cryogenic liquid helium).",
    "pmc12236423_pmc13516156_13c_pyruvate_mri_pnpla3_masld": "L1-L10:Hyperpolarized [1-13C]pyruvate metabolic MRI resolves real-time LDHA pyruvate-to-lactate flux (k_PL) with zero ionizing radiation (0 mSv), intercepting inflammatory MASH/fibrosis missed by normal serum ALT in Core20 PNPLA3 rs738409 (p.Ile148Met) carriers and early Day-14 neoadjuvant chemotherapy non-response."
  },
