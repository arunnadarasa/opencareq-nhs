  "paperclip_v2_5_evidence_pins": {
    "pmc11436614_pmc7808260_spo2_occult_hypoxemia_equity": "L1-L9:Two-wavelength (660/940 nm) pulse oximetry systematically overestimates arterial oxygen saturation (+1.8% to +3.2%) in Black and South Asian patients due to competitive epidermal eumelanin optical absorption, causing ~3.17x higher missed occult hypoxaemia (SaO2 < 88% despite SpO2 92-96%; Sjoding NEJM / UK Equity in Medical Devices Review).",
    "pmc13539841_nice_cg98_neonatal_jaundice_skin_tone": "L1-L10:Visual skin assessment of neonatal hyperbilirubinaemia across dark skin tones (Fitzpatrick V-VI) misses severe jaundice >3x more frequently; NICE CG98 mandates objective transcutaneous/serum bilirubinometry (TcB/TSB) and calibrated 460 nm blue-light Z->E bilirubin photoisomerization (PDB 2VUE) to prevent kernicterus.",
    "pmc13520761_daylight_pdt_ppix_and_mhra_voriconazole_cscc": "L1-L9:5-Aminolevulinic acid / MAL Daylight Photodynamic Therapy selectively accumulates Protoporphyrin IX (PDB 2HRE) in actinic keratoses and AMR biofilms, achieving ~86% lesion clearance via S1->T1 singlet oxygen (Phi_Delta=0.56), whereas chronic voriconazole UVA triplet photosensitization elevates transplant cutaneous squamous cell carcinoma risk ~31-fold (MHRA DSU).",
    "pmc13462880_pmc13561364_nhs_oculomics_and_hom_qoct": "L1-L11:Hong-Ou-Mandel entangled two-photon Quantum OCT achieves 2x axial resolution (~0.95 um) with exact even-order ocular water dispersion cancellation at nanowatt retinal power (75,000x below ANSI phototoxicity limits; PDB 8A6E), enabling high-street optometry oculomics across NHS England's 625,000-patient ophthalmology backlog and early Alzheimer's/CVD screening."
  },
