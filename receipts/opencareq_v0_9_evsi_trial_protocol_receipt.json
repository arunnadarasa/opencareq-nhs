  "opensafely_ehrql_source": "\"\"\"\nOpenCareQ v0.9.0 \u2014 Zero-PID OpenSAFELY ehrQL Target-Trial Emulation Specification\n(`OPENCAREQ-TTE-STAGE0`; executes strictly inside NHS SDE; cell suppression >= 10, rounded to 5).\n\"\"\"\n\nfrom ehrql import codelist_from_csv, create_dataset, days, minimum_of\nfrom ehrql.tables.tpp import (\n    addresses,\n    apcs,\n    clinical_events,\n    medications,\n    patients,\n    practice_registrations,\n)\n\ndataset = create_dataset()\ndataset.configure_dummy_data(population_size=12000)\n\n# Statutory SNOMED CT & NHSBSA dm+d codelists (version-locked under OpenCodelists)\nsmr_codes = codelist_from_csv(\"codelists/nhse-structured-medication-review-snomed.csv\", column=\"code\")\nsp_referral_codes = codelist_from_csv(\"codelists/nhse-dapb4066-social-prescribing-referral.csv\", column=\"code\")\nckd_g3_g4_codes = codelist_from_csv(\"codelists/ukrr-ckd-stage-3-4-snomed.csv\", column=\"code\")\ncyp3a4_doac_dmd = codelist_from_csv(\"codelists/opencareq-cyp3a4-doac-sglt2i-dmd.csv\", column=\"code\")\nacute_instability_excl = codelist_from_csv(\"codelists/opencareq-dcb0129-h01-acute-excl.csv\", column=\"code\")\nnco_fracture_codes = codelist_from_csv(\"codelists/opencareq-nco-extremity-fracture.csv\", column=\"code\")\n\n# Time-zero `t_0`: first eligible Clinical Pharmacist SMR in study window (Hernan & Robins 2016)\nfirst_smr = (\n    clinical_events.where(clinical_events.snomedct_code.is_in(smr_codes))\n    .where(clinical_events.date.is_on_or_between(\"2025-04-01\", \"2026-03-31\"))\n    .sort_by(clinical_events.date)\n    .first_for_patient()\n)\nindex_date = first_smr.date\n\nhas_active_ckm_rx = medications.where(\n    medications.dmd_code.is_in(cyp3a4_doac_dmd)\n    & medications.date.is_on_or_between(index_date - days(90), index_date)\n).exists_for_patient()\n\nhas_h01_acute_exclusion = clinical_events.where(\n    clinical_events.snomedct_code.is_in(acute_instability_excl)\n    & clinical_events.date.is_on_or_between(index_date - days(7), index_date)\n).exists_for_patient()\n\nage_at_index = patients.age_on(index_date)\nregistered_1yr = practice_registrations.for_patient_on(index_date).exists_for_patient()\n\ndataset.define_population(\n    first_smr.exists_for_patient()\n    & (age_at_index >= 18)\n    & registered_1yr\n    & has_active_ckm_rx\n    & (~has_h01_acute_exclusion)\n)\n\n# Exposure for Clone-Censor-Weight (`28`-day grace window post `index_date`)\nsp_ref_event = (\n    clinical_events.where(clinical_events.snomedct_code.is_in(sp_referral_codes))\n    .where(clinical_events.date.is_on_or_between(index_date, index_date + days(180)))\n    .sort_by(clinical_events.date)\n    .first_for_patient()\n)\ndataset.sp_referral_days_from_index = (sp_ref_event.date - index_date).days\ndataset.initiated_within_28d_grace = sp_ref_event.date.is_on_or_between(index_date, index_date + days(28))\n\n# Baseline Core20 IMD Quintile & Frailty Confounders (for Stabilized IPTW x IPCW)\ndataset.imd_quintile = addresses.for_patient_on(index_date).imd_quintile\ndataset.age_band = age_at_index\ndataset.has_ckd_g3_g4 = clinical_events.where(\n    clinical_events.snomedct_code.is_in(ckd_g3_g4_codes) & (clinical_events.date <= index_date)\n).exists_for_patient()\n\n# Primary 365-day Composite Unplanned Admission Endpoint & Negative-Control Outcome (`NCO`)\nfirst_unplanned_adm = (\n    apcs.where(apcs.admission_method.is_in([\"21\", \"22\", \"23\", \"24\", \"25\", \"2A\", \"2B\", \"2C\", \"2D\"]))\n    .where(apcs.admission_date.is_on_or_between(index_date + days(1), index_date + days(365)))\n    .sort_by(apcs.admission_date)\n    .first_for_patient()\n)\ndataset.primary_event_days = minimum_of((first_unplanned_adm.admission_date - index_date).days, 365)\ndataset.primary_event_indicator = first_unplanned_adm.exists_for_patient()\n\nnco_event = (\n    clinical_events.where(clinical_events.snomedct_code.is_in(nco_fracture_codes))\n    .where(clinical_events.date.is_on_or_between(index_date + days(1), index_date + days(365)))\n    .sort_by(clinical_events.date)\n    .first_for_patient()\n)\ndataset.nco_fracture_indicator = nco_event.exists_for_patient()\n",
