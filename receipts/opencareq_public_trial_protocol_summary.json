  "spirit_ai_checklist_items": [
    {
      "item_id": "SPIRIT-AI 1(i)\u2013(ii)",
      "section": "Title & Structured Summary",
      "opencareq_specification": "Explicitly identifies `OpenCareQ v0.9.0` as a Non-SaMD clinician-facing population-commissioning and `SMR` shadow decision-support workbench (`runtime_agent_actions = 0`) evaluated in a 25-PCN stepped-wedge cluster RCT (`OPENCAREQ-SW-MSE`, `E54000026`)."
    },
    {
      "item_id": "SPIRIT-AI 6a(i)\u2013(ii)",
      "section": "Background & Intended Use",
      "opencareq_specification": "Anchored on `#1 SAVI EVPPI = \u00a34.174M` (`75.3%` of `\u00a35.54M` national EVPI): tests whether adding `Core20` bilingual link-worker + warm-home co-production (`S3`) to `CKM + NICE DG59` pharmacist `SMR` (`S2`) reduces 90-day high-risk prescribing/discontinuation and unplanned hospitalisation."
    },
    {
      "item_id": "SPIRIT-AI 9",
      "section": "Study Setting & Workflow Integration",
      "opencareq_specification": "All `25` statutory PCNs (`136` GP practices, `1,218,139` registered patients) across 5 Place Alliances of NHS Mid and South Essex ICB (`E54000026`), preceded by Stage-0 `OpenSAFELY` / East of England NHS `SDE` target-trial emulation (`phi_present = False`)."
    },
    {
      "item_id": "SPIRIT-AI 10(i)\u2013(ii)",
      "section": "Cluster & Participant Eligibility",
      "opencareq_specification": "Cluster level: active statutory MSE PCNs (`N = 25`). Patient SMR cohort: adults (`>=18` yrs, `CrCl >= 15 mL/min`, non-cirrhotic `A-OCQ-04`) due `CKM`/`DOAC`/`SGLT2i`/statin/antiplatelet review; acute instability (`SpO2 < 92%`, `NEWS2 >= 5`, `H-OCQ-01`) strictly excluded upstream."
    },
    {
      "item_id": "SPIRIT-AI 11a(i)",
      "section": "Intervention Version & Frozen Lock",
      "opencareq_specification": "Frozen `OpenCareQ v0.9.0` (`ML-DSA-65` cryptographic receipt lock, 16-opcode `PCNSwarmWorld` VM with `0` runtime LLM/autonomous actions, deterministic `DCB0129Guard` commit gate)."
    },
    {
      "item_id": "SPIRIT-AI 11a(ii)\u2013(iii)",
      "section": "Input Data Acquisition & Missingness",
      "opencareq_specification": "Ingests aggregate `OGL v3.0` PCN syndemic registers (`phi_present = False`) for slot commissioning and structured `UKCore FHIR R4` / `SNOMED CT` codes inside NHS `SDE`s; missing genotypes or herbal exposures trigger mandatory `ABSTAIN` (`K-OCQ-02a..b`) until laboratory `NICE DG59` confirmation."
    },
    {
      "item_id": "SPIRIT-AI 11a(iv)",
      "section": "Human\u2013System Interaction & Override",
      "opencareq_specification": "GPhC clinical pharmacists, GMC GPs, and `DAPB4066` social-prescribing link workers retain 100% prescribing and referral authority (`TC-OCQ-02..05`), with one-click documented clinical override."
    },
    {
      "item_id": "SPIRIT-AI 11a(v)\u2013(vi)",
      "section": "Output Format & User Training",
      "opencareq_specification": "Outputs deterministic `Day-10` washout hold flags (`AUCR 1.553x` vs `4.437x`), `SGLT2i TGF` vs `AKI` discrimination, `DG59 VOI` prompts, and `ACI` conformal pathway sets (`|C_0.90| >= 2`); standardized 2-hour CSO-approved pharmacist & link-worker onboarding before each PCN's crossover quarter."
    },
    {
      "item_id": "SPIRIT-AI 22 & CSC-QT 5.6",
      "section": "Error Analysis, Harms & CSO Stopping Rules",
      "opencareq_specification": "Continuous monitoring of all `7` `OPEN` `DCB0129`/`DCB0160` hazards (`H-OCQ-01..07`); independent DMEC + CSO halts/rolls back (`TC-OCQ-07`) if rolling 90-day `ACI` coverage drops `< 85%` (`RT-03`), `Core20` slot parity falls `< 0.85` (`G6`), or any serious safety incident occurs."
    }
  ],
